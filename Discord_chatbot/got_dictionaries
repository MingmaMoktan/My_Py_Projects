intents = discord.Intents.default()
intents.message_content = True

client = discord.Client(intents=intents)

term_dict = {}
todo_dict = {}

@client.event
async def on_ready():
  print(f'We have logged in as {client.user}')

@client.event
async def on_message(message : discord.message.Message):
    if message.author == client.user: return # We don't want to reply to ourselves
    if message.content.startswith(name):
        print(f"{message.author} says: {message.content}")
        
        if message.content.startswith(f'{name} Hi'):
            await message.channel.send('I have joined into the server.')
    if message.content.startswith(f"{name} set"): # set term definition
        msg = message.content.strip()
        parts = msg.split(" ",3)
        if len(parts) == 4:
            term, definition = parts[2], parts[3]
            term_dict[term] = definition
            await message.channel.send(f"The {term} has been set.")
        elif len(parts) == 3: # set term definition
            print("2")
            term = parts[2]
            if term in term_dict:
                del term_dict[term]
                await message.channel.send(f"The {term} has been removed.")
        else:
            print("3")
            await message.channel.send(f"The {term} does not exist.")
    elif message.content.startswith(f"{name} get"):
        msg = message.content.strip()
        parts = msg.split()
        if len(parts)<3:
            await message.channel.send(f"Please provide a term.")
            return
        
        term = parts[2]
        if term in term_dict.keys():
            await message.channel.send(f"The {term}: {term_dict[term]}")
        else:
            await message.channel.send("I don't know this.")
            
            
