import sys
import discord

# discordToken = "" # Your bot token here
# name = "" # Your bot name here

if (discordToken == ""): sys.exit("ERROR: Please set the discord token.")
if (name == ""): sys.exit("ERROR: Please set the name of the bot.")

intents = discord.Intents.default()
intents.message_content = True

client = discord.Client(intents=intents)

term_dict = {}
todo_dict = {}

@client.event
async def on_ready():
  print(f'We have logged in as {client.user}')

@client.event
async def on_message(message : discord.message.Message):
    if message.author == client.user: return # We don't want to reply to ourselves
    if message.content.startswith(name):
        print(f"{message.author} says: {message.content}")
        
        if message.content.startswith(f'{name} Hi'):
            await message.channel.send('I have joined into the server.')
    if message.content.startswith(f"{name} set"): # set term definition
        msg = message.content.strip()
        parts = msg.split(" ",3)
        if len(parts) == 4:
            term, definition = parts[2], parts[3]
            term_dict[term] = definition
            await message.channel.send(f"The {term} has been set.")
        elif len(parts) == 3: # set term definition
            print("2")
            term = parts[2]
            if term in term_dict:
                del term_dict[term]
                await message.channel.send(f"The {term} has been removed.")
        else:
            print("3")
            await message.channel.send(f"The {term} does not exist.")
    elif message.content.startswith(f"{name} get"):
        msg = message.content.strip()
        parts = msg.split()
        if len(parts)<3:
            await message.channel.send(f"Please provide a term.")
            return
        
        term = parts[2]
        if term in term_dict.keys():
            await message.channel.send(f"The {term}: {term_dict[term]}")
        else:
            await message.channel.send("I don't know this.")
            
            
# Adding the todo list here and implementing it here.
            
    if message.content.startswith(f"{name} todo"): # Adding todo
        msg = message.content.strip()
                        
        if msg == f"{name} todo":
            if todo_dict:
                for i in todo_dict.keys():
                    await message.channel.send(f"{i}:{todo_dict[i]}")
                print(type(i)) # Here the keys of the dictionary are stored in the form of integer
            else:
                await message.channel.send("Your todo list is empty.")
        elif len(todo_dict)>=5:
            await message.channel.send("Too many items!")
            return
        else:
            to_do = msg.replace(f"{name} todo", "")
            if len(to_do)<1:
                await message.channel.send("Put the item on todo list.")
            else:
                if todo_dict:
                    next_key = max(todo_dict.keys()) + 1
                else:
                    next_key = 1
                todo_dict[next_key]=to_do
                print(todo_dict)
                await message.channel.send(f"Added todo item: {to_do}")
    # To remove the items from the todo list
    elif message.content.startswith("todoremove"):
        try:
            msg_list = message.content.split(" ")
            remove_item = int(msg_list[1])
            print(msg_list)
            print(remove_item)
            if remove_item in todo_dict.keys():
                await message.channel.send(f"The item {todo_dict[remove_item]} has been removed from the todo")
                del todo_dict[remove_item]
            else:
                await message.channel.send("Not such todo item with that number.")
        except ValueError:
            await message.channel.send("Please enter the valid number.")
        except Exception:
            await message.channel.send("Please write the todoremove followed by the number number of the item you want to remove.")
            
    elif message.content.lower()=="help":
        await message.channel.send("""
                                   Here are the useful commands to help you
                                    For setting the term and definition
                                    1. Write set <term> <definition> to set the term and definition.
                                    2. Write get <term> to get the definition of the term you want.
                                     
                                    For todo list
                                    1. Write the todo <actual todo task> to add the todo to the list.
                                    2. Write the todo to get the list of the todo you have created.
                                    3. Write todoremove <number> to remove the todo task from the todo list.
                                    """)
        pass   
            
